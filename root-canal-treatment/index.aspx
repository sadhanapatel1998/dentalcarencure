<script type="text/javascript">

    function IsBookValidate() {       
        var nam = document.getElementById('txtname').value.trim();
        var mail = document.getElementById('txtmail').value;
        var mob = document.getElementById('txtphone').value.trim();
        var adate = document.getElementById('inquiry-date-check-out').value.trim();

        if (nam.length == 0) {
            alert('Please Enter Name !');
            document.getElementById('txtname').focus();
            return false;
        }
        var tmail = mail.toString();
        tmail = tmail.replace(/^\s+|\s+$/g, '');
        if (tmail == "") {
            alert('Please Enter Email Id...');
            document.getElementById('txtmail').focus();
            return false;
        }
        var atpos = mail.indexOf("@");
        var dotpos = mail.lastIndexOf(".");
        if (atpos < 1 || dotpos < atpos + 2 || dotpos + 2 >= mail.length) {
            alert("Not a valid e-mail address");
            document.getElementById('txtmail').select();
            document.getElementById('txtmail').focus();
            return false;
        }
        if (adate.length == 0) {
            alert('Please Enter Appointment Date...');
            document.getElementById('inquiry-date-check-out').focus();
            return false;
        }
        var soFar1 = mob.toString();
        soFar1 = soFar1.replace(/^\s+|\s+$/g, '');
        if (soFar1 == "" || soFar1.length < 5) {
            alert('Please Enter Valid Mobile No...');
            document.getElementById('txtphone').focus();
            return false;
        }
        document.getElementById('btnSubmit').value = 'Please Wait..';
        document.getElementById('btnSubmit').style.cursor = 'wait';
        setTimeout(function () {
            document.getElementById('btnSubmit').value = 'Submit';
            document.getElementById('btnSubmit').style.cursor = '';
        }, 1500);
        return true;
    }

