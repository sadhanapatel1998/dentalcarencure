            <h2>Root Canal Treatment</h2>
                <div class="col-md-3">
                    <div>
                        <img src="img/root-canel.png" alt="Owner Image" class="img-responsive" style="padding: 5px;
    border: 5px solid #f9690d;
    margin-bottom: 10px;">
    
     <img src="img/root-canal-treatment.png" alt="Owner Image" class="img-responsive" style="padding: 5px;
    border: 5px solid #f9690d;
    margin-bottom: 10px;">
                         <img src="img/root-canel-2.png" alt="Owner Image" class="img-responsive">
