function IsContactValidate() {
    var nam = document.getElementById('txtname').value;
    var mail = document.getElementById('txtmail').value;
    var mob = document.getElementById('txtphone').value;
    
    if (nam == '') {
        alert('Please Enter Name !');
        document.getElementById('txtname').focus();
        return false;
    }
    var tmail = mail.toString();
    tmail = tmail.replace(/^\s+|\s+$/g, '');
    if (tmail == "") {
        alert('Please Enter Email Id...');
        document.getElementById('txtmail').focus();
        return false;
    }
    var atpos = mail.indexOf("@");
    var dotpos = mail.lastIndexOf(".");
    if (atpos < 1 || dotpos < atpos + 2 || dotpos + 2 >= mail.length) {
        alert("Not a valid e-mail address");
        document.getElementById('txtmail').select();
        document.getElementById('txtmail').focus();
        return false;
    }
    var soFar1 = mob.toString();
    soFar1 = soFar1.replace(/^\s+|\s+$/g, '');
    if (soFar1 == "" || soFar1.length < 10) {
        alert('Please Enter Valid Mobile No...');
        document.getElementById('txtphone').focus();
        return false;
    }
    
    
    document.getElementById('btn_send').value = 'Please Wait..';
    document.getElementById('btn_send').style.cursor = 'wait';
    setTimeout(function () {
        document.getElementById('btn_send').value = 'Send Query';
        document.getElementById('btn_send').style.cursor = '';
    }, 3000);
    return true;
}
function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (charCode > 31 && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }
